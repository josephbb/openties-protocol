{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publisher policy",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": "0.3"
    },
    "policyId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "policyUrl": {
      "type": "string",
      "format": "uri"
    },
    "role": {
      "const": "author"
    },
    "relationshipTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ]
      }
    },
    "organizations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "externalIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[a-zA-Z0-9._:/-]+$"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "ties"
              },
              "relationshipTypes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "organizationIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "window": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "lookback"
                      },
                      "months": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1200
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "months"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "submitted-work"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ]
                  }
                ]
              },
              "organizationTypeIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "anyRelationship": {
                "const": true
              },
              "anyOrganization": {
                "const": true
              },
              "relationshipCategoryIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "kind",
              "window"
            ],
            "allOf": [
              {
                "oneOf": [
                  {
                    "required": [
                      "anyRelationship"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "relationshipTypes"
                          ]
                        },
                        {
                          "required": [
                            "relationshipCategoryIds"
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "anyOf": [
                      {
                        "required": [
                          "relationshipTypes"
                        ]
                      },
                      {
                        "required": [
                          "relationshipCategoryIds"
                        ]
                      }
                    ],
                    "not": {
                      "required": [
                        "anyRelationship"
                      ]
                    }
                  }
                ]
              },
              {
                "oneOf": [
                  {
                    "required": [
                      "anyOrganization"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "organizationIds"
                          ]
                        },
                        {
                          "required": [
                            "organizationTypeIds"
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "anyOf": [
                      {
                        "required": [
                          "organizationIds"
                        ]
                      },
                      {
                        "required": [
                          "organizationTypeIds"
                        ]
                      }
                    ],
                    "not": {
                      "required": [
                        "anyOrganization"
                      ]
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "author-question"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "kind"
            ]
          }
        ]
      },
      "minItems": 1
    },
    "organizationTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "definition"
        ]
      }
    },
    "relationshipCategories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "relationshipTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "relationshipTypes"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "policyId",
    "revision",
    "publisher",
    "title",
    "policyUrl",
    "role",
    "relationshipTypes",
    "organizations",
    "rules"
  ]
}
